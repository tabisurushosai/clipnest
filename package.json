{
  "name": "clipnest",
  "version": "1.0.0",
  "description": "AI Clipboard History for Chrome",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "i18n:check": "bash scripts/check_i18n.sh",
    "test:coverage": "vitest run --coverage",
    "release": "bash scripts/build_release.sh",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^4.1.6"
  }
}
